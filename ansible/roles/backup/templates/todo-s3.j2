#!/usr/bin/env python3
"""Envio e leitura de backups no S3 usando o perfil IAM da VM (gerenciado pelo Ansible)."""
import sys

import boto3

BUCKET = "{{ backup_bucket }}"
PREFIX = "{{ deploy_env }}/"
s3 = boto3.client("s3", region_name="{{ aws_region }}")


def main(args):
    if len(args) == 3 and args[0] == "put":
        s3.upload_file(args[1], BUCKET, PREFIX + args[2])
        print(f"s3://{BUCKET}/{PREFIX}{args[2]}")
    elif len(args) == 3 and args[0] == "get":
        s3.download_file(BUCKET, PREFIX + args[1], args[2])
    elif len(args) == 1 and args[0] == "latest":
        keys = []
        for page in s3.get_paginator("list_objects_v2").paginate(Bucket=BUCKET, Prefix=PREFIX):
            keys += [o["Key"][len(PREFIX):] for o in page.get("Contents", []) if o["Key"].endswith(".archive.gz")]
        if not keys:
            sys.exit("Nenhum backup encontrado no S3")
        print(sorted(keys)[-1])
    else:
        sys.exit("uso: todo-s3 put <arquivo> <nome> | get <nome> <arquivo> | latest")


if __name__ == "__main__":
    main(sys.argv[1:])
